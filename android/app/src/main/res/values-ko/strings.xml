    <string name="dns_cleanbrowsing_desc">성인 사이트·우회용 프록시 차단, 구글·빙·유튜브 안전 모드</string>
    <string name="dns_adguard">AdGuard 가족 보호</string>
    <string name="dns_adguard_desc">성인 사이트·광고·추적기 차단, 구글·빙·유튜브 안전 모드</string>
    <string name="dns_cloudflare">Cloudflare 가족용</string>
