    <string name="app_tagline">시크릿 모드와 성인 사이트를 차단합니다</string>

    <string name="accessibility_service_label">IncognitoBlocker 시크릿 모드 차단</string>
    <string name="accessibility_service_description">브라우저 화면에서 시크릿 · 프라이빗 모드 표시를 찾아내 해당 창을 닫습니다. 지정된 브라우저 앱의 화면만 확인하며, 방문한 웹사이트 주소나 내용은 저장하지 않고 외부로 전송하지 않습니다.</string>
    <string name="notification_service_label">IncognitoBlocker 알림 감시</string>

    <string name="status_setup_needed">설정을 시작해 주세요</string>
