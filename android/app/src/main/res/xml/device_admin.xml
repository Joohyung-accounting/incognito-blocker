<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal policy set on purpose.

  Wiping the device (wipe-data) and locking the screen (force-lock) are NOT
  requested. This app blocks a browser feature; it is not here to hold a phone
  hostage.

  For device-owner promotion the <device-admin> declaration only has to exist —
  uses-policies may be empty, so it is. watch-login used to be here, unused, and
  made the activation screen promise to "erase all the phone's data if too many
  incorrect passwords are typed" — the opposite of the explanation beside it.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
